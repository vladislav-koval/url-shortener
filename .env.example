POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=url_shortener_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_TIMEOUT=10s

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_DB=0
SHORTENER_CACHE_TTL=24h
# Список доменов (через запятую), которые нельзя сокращать — сам домен и любые его поддомены.
SHORTENER_BANNED_DOMAINS=

KAFKA_ADVERTISED_HOST=localhost
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=shortener.link-clicks
KAFKA_PRODUCER_FLUSH_INTERVAL=5s
KAFKA_PRODUCER_WRITE_TIMEOUT=2s
KAFKA_PRODUCER_BATCH_SIZE=500
KAFKA_PRODUCER_QUEUE_SIZE=10000

KAFKA_CONSUMER_BATCH_SIZE=500
KAFKA_CONSUMER_BATCH_TIMEOUT=5s
# 1 горутина на 1 партицию
KAFKA_CONSUMER_GOROUTINES_COUNT=3

LOGGER_LEVEL=Debug
LOGGER_FOLDER=./out/logs

HTTP_ADDR=:5050
HTTP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

SHUTDOWN_TIMEOUT=30s

CORE_TIME_ZONE=UTC

AUTHORIZATION_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
AUTH_SESSION_TTL=720h

GOOGLE_AUTH_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=changeme
GOOGLE_AUTH_CALLBACK_URL=http://localhost:5050/api/v1/auth/google/callback
GOOGLE_AUTH_EXCHANGE_TIMEOUT=10s

GRPC_ADDR=:50051

GRPC_CLIENT_ADDR=localhost:50051
GRPC_CLIENT_MAX_RETRIES=3
GRPC_CLIENT_PER_TIMEOUT=1s

GEO_FILE_PATH=data/geo-city.mmdb
GEO_REQUIRED=false

# Фронтенд (build args для сервиса frontend — NEXT_PUBLIC_* вшиваются в бандл на этапе билда)
NEXT_PUBLIC_API_BASE_URL=http://localhost
NEXT_PUBLIC_SITE_URL=http://localhost