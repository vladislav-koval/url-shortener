POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=url_shortener_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_TIMEOUT=10s

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_DB=0
SHORTENER_CACHE_TTL=24h

KAFKA_ADVERTISED_HOST=localhost
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=shortener.link-clicks
KAFKA_PRODUCER_FLUSH_INTERVAL=5s
KAFKA_PRODUCER_WRITE_TIMEOUT=2s
KAFKA_PRODUCER_BATCH_SIZE=500
KAFKA_PRODUCER_QUEUE_SIZE=10000

KAFKA_CONSUMER_BATCH_SIZE=500
KAFKA_CONSUMER_BATCH_TIMEOUT=5s
# 1 горутина на 1 партицию
KAFKA_CONSUMER_GOROUTINES_COUNT=3

LOGGER_LEVEL=Debug
LOGGER_FOLDER=./out

HTTP_ADDR=:5050
HTTP_ALLOWED_ORIGINS=http://localhost:5050,http://127.0.0.1:5050

SHUTDOWN_TIMEOUT=30s

CORE_TIME_ZONE=UTC

AUTHORIZATION_COOKIE_SECURE=false
AUTH_SUCCESS_REDIRECT_URL=http://localhost:5050/
AUTH_SESSION_TTL=720h

GOOGLE_AUTH_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=changeme
GOOGLE_AUTH_CALLBACK_URL=http://localhost:5050/auth/google/callback

GRPC_ADDR=:50051

GRPC_CLIENT_ADDR=localhost:50051
GRPC_CLIENT_MAX_RETRIES=3
GRPC_CLIENT_PER_TIMEOUT=1s

